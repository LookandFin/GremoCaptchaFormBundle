{
    "name": "gremo/captcha-form-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle that provides CAPTCHA form field and supports multiple adapters.",
    "keywords": [
        "abuse",
        "bot",
        "captcha",
        "recaptcha",
        "spam"
    ],
    "license": "ISC",
    "authors": [
        {
            "name": "Marco Polichetti",
            "email": "gremo1982@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^7.2"
    },
    "require-dev": {
        "google/recaptcha": "^1.1",
        "gregwar/captcha": "^1.1",
        "symfony/form": "^7.2",
        "symfony/options-resolver": "^7.2",
        "symfony/validator": "^7.2"
    },
    "suggest": {
        "google/recaptcha": "Allows you to use Google reCAPTCHA adapter",
        "gregwar/captcha": "Allows you to use Gregwar/Captcha adapter"
    },
    "autoload": {
        "psr-4": {
            "Gremo\\CaptchaFormBundle\\": ""
        }
    }
}
